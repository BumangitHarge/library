
@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; max-width: 36rem;">
    <div class="card-body p-4" style="background-color: #10243e; color: white;">
        <h1 class="mb-1 fw-bold" style="color: white;">Borrow a book</h1>
        <p class="mb-0" style="color: #cbd5e1;">
            Fill out the details below to record a new book loan.
        </p>
    </div>

    <div class="card-body p-4">
        <form asp-action="Borrow" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="MemberId" class="form-label fw-semibold" style="color: #10243e;">
                    Select Member
                </label>
                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                    <option value="">(choose a member)</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="BookId" class="form-label fw-semibold" style="color: #10243e;">
                    Select Book
                </label>
                <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                    <option value="">(choose a book)</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DaysAllowed" class="form-label fw-semibold" style="color: #10243e;">
                    Number of Days Allowed
                </label>
                <input asp-for="DaysAllowed" class="form-control" />
                <span asp-validation-for="DaysAllowed" class="text-danger small"></span>
                <small class="text-muted">Enter how many days the member can keep the book.</small>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn fw-semibold px-4"
                        style="background-color: #10243e; color: white;">
                    Borrow Book
                </button>
                <a asp-action="Index" class="btn fw-semibold px-4"
                   style="background-color: #DC3545; color: white;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
