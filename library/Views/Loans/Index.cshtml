@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
    <div class="card-body p-4" style="background-color: #10243e; color: white;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="mb-1 fw-bold" style="color: white;">Loans</h1>
                <p class="mb-0" style="color: #cbd5e1;">
                    Manage borrowed books and track their status.
                </p>
            </div>

            <a asp-action="Borrow"
               class="btn fw-semibold"
               style="background-color: white; color: #10243e;">
                + Borrow a book
            </a>
        </div>
    </div>

    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-bold" style="color: #10243e;">Loan Records</h5>
            <span class="badge rounded-pill px-3 py-2"
                  style="background-color: #e8edf4; color: #10243e;">
                @Model.Count total loans
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr style="background-color: #10243e; color: white;">
                        <th class="py-3">Member</th>
                        <th class="py-3">Book</th>
                        <th class="py-3">Loaned</th>
                        <th class="py-3">Due</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@loan.MemberName</td>
                            <td>@loan.BookTitle</td>
                            <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                            <td>@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2
                                    @(loan.Status == "Overdue" ? "text-bg-danger" : loan.Status == "Out" ? "text-dark" : "text-bg-success")"
                                      style="@(loan.Status == "Out" ? "background-color: #f5d76e;" : "")">
                                    @loan.Status
                                </span>
                            </td>
                            <td class="text-end">
                                @if (loan.ReturnedOn == null)
                                {
                                    <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                        <button type="submit"
                                                class="btn btn-sm fw-semibold"
                                                style="border: 1px solid #198754; color: #198754;">
                                            Return
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
