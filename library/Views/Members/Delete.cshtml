@model Member
@{
    ViewData["Title"] = "Delete Member";
}

<h1 class="mb-3">Delete Member</h1>

<div class="card card-body" style="max-width:36rem">
    <p>Are you sure you want to delete this member?</p>

    <dl class="row">
        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.FullName</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

        <dt class="col-sm-4">Type</dt>
        <dd class="col-sm-8">@Model.MemberType</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input asp-for="MemberId" type="hidden" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>