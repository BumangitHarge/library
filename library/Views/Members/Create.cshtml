@model Member
@{
    ViewData["Title"] = "Add a Member";
}

<div class="card border-0 shadow-sm mb-4"
     style="border-radius: 12px; overflow: hidden; max-width: 36rem;">

    <div class="card-body p-4" style="background-color: #10243e; color: white;">
        <h1 class="mb-1 fw-bold" style="color: white;">Add a Member</h1>
        <p class="mb-0" style="color: #cbd5e1;">
            Enter the details below to register a new library member.
        </p>
    </div>

    <div class="card-body p-4">
        <form asp-action="Create" method="post">

            <div class="mb-4">
                <label asp-for="FullName" class="form-label fw-semibold"
                       style="color: #10243e;"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-semibold"
                       style="color: #10243e;"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="MemberType" class="form-label fw-semibold"
                       style="color: #10243e;"></label>
                <select asp-for="MemberType" class="form-select">
                    <option>Regular</option>
                    <option>Student</option>
                    <option>Faculty</option>
                </select>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn fw-semibold px-4"
                        style="background-color: #10243e; color: white;">
                    Save Member
                </button>

                <a asp-action="Index" class="btn fw-semibold px-4"
                   style="background-color: #DC3545; color: white;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
