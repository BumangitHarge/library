@model Note

@{
    ViewData["Title"] = "Delete Note";
}

<h1 class="mb-3">Delete Note</h1>

<div class="card card-body" style="max-width: 36rem">

    <p>Are you sure you want to delete this note?</p>

    <dl class="row">
        <dt class="col-sm-4">Title</dt>
        <dd class="col-sm-8">@Model.Title</dd>

        <dt class="col-sm-4">Body</dt>
        <dd class="col-sm-8">@(Model.Body ?? "—")</dd>

        <dt class="col-sm-4">Created On</dt>
        <dd class="col-sm-8">@Model.CreatedOn.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input asp-for="NoteId" type="hidden" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>

</div>