
@model Book
@{
    ViewData["Title"] = "Delete a book";
}

<div class="card border-0 shadow-sm mb-4"
     style="border-radius: 12px; overflow: hidden; max-width: 36rem;">

    <div class="card-body p-4" style="background-color: #10243e; color: white;">
        <h1 class="mb-1 fw-bold" style="color: white;">Delete a Book</h1>
        <p class="mb-0" style="color: #cbd5e1;">
            Review the book information before confirming deletion.
        </p>
    </div>

    <div class="card-body p-4">

        <div class="alert alert-danger">
            <strong>Warning!</strong> Are you sure you want to delete this book?
        </div>

        <dl class="row mb-4">
            <dt class="col-4" style="color: #10243e;">Title</dt>
            <dd class="col-8 fw-semibold">@Model.Title</dd>

            <dt class="col-4" style="color: #10243e;">Category</dt>
            <dd class="col-8">@(Model.Category ?? "—")</dd>

            <dt class="col-4" style="color: #10243e;">Price</dt>
            <dd class="col-8">@(Model.Price?.ToString("N2") ?? "—")</dd>
        </dl>

        <div class="alert alert-warning small">
            Any loans of this book are deleted with it.
        </div>

        <form asp-action="Delete" asp-route-id="@Model.BookId" method="post">
            <div class="d-flex gap-2">
                <button type="submit" class="btn fw-semibold px-4"
                        style="background-color: #DC3545; color: white;">
                    Delete Book
                </button>

                <a asp-action="Index" class="btn fw-semibold px-4"
                   style="background-color: #f5d76e; color: #10243e;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
